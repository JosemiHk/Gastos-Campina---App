{
  "name": "campina-gastos",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/config.mjs && ng serve --host 127.0.0.1",
    "build": "node scripts/config.mjs && ng build",
    "watch": "node scripts/config.mjs && ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:db": "node scripts/test-db.mjs",
    "test:upgrade": "node scripts/test-db.mjs --upgrade",
    "format": "prettier --write src scripts",
    "format:check": "prettier --check src scripts",
    "security:check": "node scripts/audit-secrets.mjs --history",
    "test:security": "node --test scripts/audit-secrets.test.mjs",
    "prepare:supabase": "node scripts/prepare-supabase.mjs",
    "test:setup": "npm run prepare:supabase && node scripts/test-db.mjs --setup",
    "test:weighted-upgrade": "node scripts/test-db.mjs --weighted-upgrade",
    "test:rounding-upgrade": "node scripts/test-db.mjs --rounding-upgrade"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "html-to-image": "^1.11.13",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@electric-sql/pglite": "^0.5.10",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
